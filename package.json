{
  "name": "carolcalca",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "tinacms dev -c \"NODE_ENV=production next build\"",
    "build:cloud": "tinacms build && next build",
    "pedido:local": "wrangler dev --config servidor/wrangler.toml --port 8787",
    "pedido:chave": "wrangler secret put RESEND_API_KEY --config servidor/wrangler.toml",
    "pedido:publicar": "wrangler deploy --config servidor/wrangler.toml"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tinacms": "3.15.2"
  },
  "devDependencies": {
    "@tinacms/cli": "4.0.5",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.9.3",
    "wrangler": "4.159.0"
  },
  "engines": {
    "node": "22.x || 24.x"
  }
}
